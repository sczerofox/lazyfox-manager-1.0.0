<service>
  <!-- 唯一服务ID -->
  <id>OssManagerService</id>
  <!-- 显示服务的名称 -->
  <name>Oss Manager Service</name>
  <!-- 服务描述 -->
  <description>Oss Manager 对象存储服务</description>
  <!-- 将java程序添加到系统服务 -->
  <executable>java</executable>
  <!-- 执行的参数 -->
  <arguments>-jar "D:\lazyfox-manager-1.1.4\boot\oss-manager-1.3.0.jar"</arguments>
  <!-- 日志模式 -->
  <logpath>D:\lazyfox-manager-1.1.4\logs\servicelogs</logpath>
   <log mode="roll-by-size">
       <sizeThreshold>3</sizeThreshold>
       <keepFiles>8</keepFiles>
   </log>
   <!--<log mode="none"></log>-->
</service> 